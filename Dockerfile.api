FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg fontconfig fonts-hosny-amiri fonts-liberation2 fonts-open-sans libfribidi0 libharfbuzz0b libass9 redis-tools unzip \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md /app/
RUN python - <<'PY' > /tmp/requirements.txt
import tomllib

with open("pyproject.toml", "rb") as handle:
    project = tomllib.load(handle)["project"]
print("\n".join(project["dependencies"]))
PY
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY packages /app/packages
COPY apps/api /app/apps/api
COPY worker /app/worker
COPY scripts /app/scripts
COPY config /app/config
RUN pip install --no-cache-dir --no-deps -e .

EXPOSE 8000
CMD ["uvicorn", "quran_video_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
